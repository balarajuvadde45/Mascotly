# Mascot configuration — copy to .env (local) or set in your hosting dashboard.
# Everything runs with zero configuration; everything below is optional.

# ── Core ────────────────────────────────────────────────────────────────────
# MASCOT_PORT=4242
# MASCOT_HOST=0.0.0.0
# MASCOT_DATA_DIR=./data
# MASCOT_ADMIN_KEY=            # recommended in production; else generated

# ── Storage ─────────────────────────────────────────────────────────────────
# "file" (default) for local/Docker/VPS; "upstash" for serverless (auto on Vercel)
# MASCOT_STORE=file
# MASCOT_KV_PREFIX=mascot:
# UPSTASH_REDIS_REST_URL=      # or KV_REST_API_URL (Vercel KV injects this)
# UPSTASH_REDIS_REST_TOKEN=    # or KV_REST_API_TOKEN

# ── LLM brain (any one of these; offline extractive brain without them) ─────
# MASCOT_LLM_PROVIDER=openai-compatible
# MASCOT_LLM_BASE_URL=https://api.openai.com/v1
# MASCOT_LLM_API_KEY=sk-...
# MASCOT_LLM_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=

# ── Embeddings (optional; local TF-IDF by default) ──────────────────────────
# MASCOT_EMBEDDINGS_PROVIDER=none
# MASCOT_EMBEDDINGS_API_KEY=

# ── Crawling / REA / limits ─────────────────────────────────────────────────
# MASCOT_CRAWL_MAX_PAGES=15
# MASCOT_MAX_CHUNKS=20000
# MASCOT_REA_TIMEOUT=300000
# GITHUB_TOKEN=                # higher GitHub API rate limits for repo ingestion
